# Copy to .env.local. The app runs in demo mode with none of these set.

# Supabase (auth, db, storage) - https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LLM: set at least one. Google is tried first.
GOOGLE_GENERATIVE_AI_API_KEY=   # https://aistudio.google.com/apikey
GROQ_API_KEY=                   # https://console.groq.com/keys

# Optional model overrides
# GOOGLE_CHAT_MODEL=gemini-2.5-flash
# GOOGLE_FAST_MODEL=gemini-2.5-flash-lite
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Image / video gateway (when Studio and Reels land)
# FAL_KEY=
