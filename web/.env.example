# Copy to .env.local. Local defaults work with a MongoDB on localhost:27017.

# MongoDB - local, or a free MongoDB Atlas M0 cluster (mongodb+srv://...)
# Local Mongo must run as a replica set (auth uses transactions); Atlas already does.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=kreo

# Auth (Better Auth). Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Local testing without email/SMS: links and codes go to /api/dev/outbox. NEVER set on a public deploy.
NEXT_PUBLIC_DEV_OUTBOX=1

# Google sign-in (optional) - https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM: set at least one. Google is tried first.
GOOGLE_GENERATIVE_AI_API_KEY=   # https://aistudio.google.com/apikey
GROQ_API_KEY=                   # https://console.groq.com/keys

# Image / video gateway (when Studio and Reels land)
# FAL_KEY=
